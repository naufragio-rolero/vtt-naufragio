# Template, not installed. Supply TRUSTED_PROXY_TOKEN privately before startup.
NODE_ENV=production
HOST=127.0.0.1
PORT=3400
ALLOWED_ORIGINS=https://naufragio-rolero.github.io
SOCKET_PATH=/socket.io
MAX_MESSAGE_BYTES=65536
MAX_BODY_BYTES=16384
TRUST_PROXY_LOOPBACK=true
DATABASE_PATH=/mnt/ssd/services/naufragio-vtt/data/naufragio.sqlite
ENABLE_DIAGNOSTICS=false
HTTP_RATE_LIMIT=600
CONNECTION_LIMIT=32
ACCOUNT_CONNECTION_LIMIT=4
GUEST_QR_TTL_SECONDS=3600
GUEST_REQUEST_TTL_SECONDS=300
GUEST_SESSION_TTL_SECONDS=1800
GUEST_LIMIT=16
GUEST_REQUEST_RATE_LIMIT=20
