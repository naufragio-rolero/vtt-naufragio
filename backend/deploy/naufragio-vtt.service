# Private supervised installation. No automatic start until separately authorized.
[Unit]
Description=Naufragio VTT isolated backend
After=network.target
RequiresMountsFor=/mnt/ssd/naufragio-vtt/data

[Service]
Type=notify
NotifyAccess=main
User=naufragio-vtt
Group=naufragio-vtt
WorkingDirectory=/opt/naufragio-vtt/current/backend
EnvironmentFile=/etc/naufragio-vtt/backend.env
Environment=UV_THREADPOOL_SIZE=1
ExecStart=/usr/bin/python3 /opt/naufragio-vtt/current/backend/deploy/supervisor.py
Restart=no
WatchdogSec=10
WatchdogSignal=SIGKILL
TimeoutStartSec=45
TimeoutStopSec=8
KillMode=control-group
UMask=0077
Nice=10
CPUQuota=100%
# memory controller is disabled at boot: do not claim kernel memory enforcement.
# External supervisor stops at 160 MiB summed Node + supervisor RSS.
TasksMax=32
LimitNOFILE=1024
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/mnt/ssd/naufragio-vtt/data
ReadOnlyPaths=/opt/naufragio-vtt
StandardOutput=journal
StandardError=journal
SyslogIdentifier=naufragio-vtt

[Install]
WantedBy=multi-user.target
