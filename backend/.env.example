# Public operational values only; this phase needs no credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3400
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:3400
SOCKET_PATH=/socket.io
MAX_BODY_BYTES=16384
MAX_MESSAGE_BYTES=16384
RATE_WINDOW_MS=60000
HTTP_RATE_LIMIT=120
HANDSHAKE_RATE_LIMIT=20
EVENT_RATE_LIMIT=30
CONNECTION_LIMIT=32
ENABLE_DIAGNOSTICS=false
