# No account passwords or usable credentials. Enable proxy mode only with a privately generated secret.
TRUST_PROXY_LOOPBACK=false
# TRUSTED_PROXY_TOKEN must be 64 random hexadecimal characters when proxy mode is enabled. No default.
NODE_ENV=development
HOST=127.0.0.1
PORT=3400
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:3400
SOCKET_PATH=/socket.io
MAX_BODY_BYTES=16384
MAX_MESSAGE_BYTES=65536
RATE_WINDOW_MS=60000
HTTP_RATE_LIMIT=120
HANDSHAKE_RATE_LIMIT=20
EVENT_RATE_LIMIT=120
CONNECTION_LIMIT=32
ACCOUNT_CONNECTION_LIMIT=4
ENABLE_DIAGNOSTICS=false
DATABASE_PATH=./data/naufragio.sqlite
AUTH_RATE_LIMIT=10
AUTH_WINDOW_MS=300000
SESSION_TTL_SECONDS=1800
INVITATION_TTL_SECONDS=86400
ROOM_CODE_TTL_SECONDS=86400
ROOM_INVITATION_TTL_SECONDS=86400
ROOM_JOIN_RATE_LIMIT=10
GUEST_QR_TTL_SECONDS=3600
GUEST_REQUEST_TTL_SECONDS=300
GUEST_SESSION_TTL_SECONDS=1800
GUEST_LIMIT=16
GUEST_REQUEST_RATE_LIMIT=20
